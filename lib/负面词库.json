    "mirror":    ["quality", "anatomy", "face", "style", "character", "cloth", "mirror"],

    "duo":       ["quality", "anatomy", "face", "duplicate", "style", "duo", "character", "cloth"],

    "thick":     ["quality", "anatomy", "face", "duplicate", "style", "solo", "character", "cloth", "lightThick", "sceneWood"]
